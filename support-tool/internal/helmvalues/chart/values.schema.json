{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "provider": {
          "enum": [
            "openshift",
            "cert-manager"
          ]
        },
        "mutual_enabled": {
          "type": "boolean"
        },
        "cert-manager": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "createSelfSignedIssuer": {
              "type": "boolean"
            },
            "cluster-issuer": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "provider"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              },
              "provider": {
                "const": "cert-manager"
              }
            },
            "required": [
              "enabled",
              "provider"
            ]
          },
          "then": {
            "required": [
              "cert-manager"
            ],
            "properties": {
              "cert-manager": {
                "required": [
                  "cluster-issuer"
                ],
                "properties": {
                  "cluster-issuer": {
                    "minLength": 1
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "mutual_enabled": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "controlplane": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "observability": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "grafana": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "notifications": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "slack": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "enabled": {
                          "type": "boolean"
                        },
                        "url": {
                          "type": "string"
                        }
                      },
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "enabled": {
                                "const": true
                              }
                            },
                            "required": [
                              "enabled"
                            ]
                          },
                          "then": {
                            "required": [
                              "url"
                            ],
                            "properties": {
                              "url": {
                                "minLength": 1
                              }
                            }
                          }
                        }
                      ]
                    },
                    "teams": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "enabled": {
                          "type": "boolean"
                        },
                        "url": {
                          "type": "string"
                        }
                      },
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "enabled": {
                                "const": true
                              }
                            },
                            "required": [
                              "enabled"
                            ]
                          },
                          "then": {
                            "required": [
                              "url"
                            ],
                            "properties": {
                              "url": {
                                "minLength": 1
                              }
                            }
                          }
                        }
                      ]
                    },
                    "pagerduty": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "enabled": {
                          "type": "boolean"
                        },
                        "integrationKey": {
                          "type": "string"
                        },
                        "severity": {
                          "enum": [
                            "info",
                            "warning",
                            "error",
                            "critical"
                          ]
                        },
                        "class": {
                          "type": "string"
                        },
                        "component": {
                          "type": "string"
                        },
                        "group": {
                          "type": "string"
                        }
                      },
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "enabled": {
                                "const": true
                              }
                            },
                            "required": [
                              "enabled"
                            ]
                          },
                          "then": {
                            "required": [
                              "integrationKey"
                            ],
                            "properties": {
                              "integrationKey": {
                                "minLength": 1
                              }
                            }
                          }
                        }
                      ]
                    },
                    "opsgenie": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "enabled": {
                          "type": "boolean"
                        },
                        "apiKey": {
                          "type": "string"
                        },
                        "apiUrl": {
                          "type": "string"
                        },
                        "autoClose": {
                          "type": "boolean"
                        },
                        "overridePriority": {
                          "type": "boolean"
                        },
                        "sendTagsAs": {
                          "enum": [
                            "tags",
                            "details",
                            "both"
                          ]
                        }
                      },
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "enabled": {
                                "const": true
                              }
                            },
                            "required": [
                              "enabled"
                            ]
                          },
                          "then": {
                            "required": [
                              "apiKey"
                            ],
                            "properties": {
                              "apiKey": {
                                "minLength": 1
                              }
                            }
                          }
                        }
                      ]
                    },
                    "webhook": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "enabled": {
                          "type": "boolean"
                        },
                        "url": {
                          "type": "string"
                        },
                        "httpMethod": {
                          "enum": [
                            "POST",
                            "PUT"
                          ]
                        },
                        "username": {
                          "type": "string"
                        },
                        "password": {
                          "type": "string"
                        },
                        "authorizationScheme": {
                          "type": "string"
                        },
                        "authorizationCredentials": {
                          "type": "string"
                        },
                        "maxAlerts": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "enabled": {
                                "const": true
                              }
                            },
                            "required": [
                              "enabled"
                            ]
                          },
                          "then": {
                            "required": [
                              "url"
                            ],
                            "properties": {
                              "url": {
                                "minLength": 1
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "pullPolicy": {
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              }
            },
            "logParser": {
              "enum": [
                "cri",
                "docker"
              ]
            },
            "graylog": {
              "type": "object",
              "properties": {
                "pullPolicy": {
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              }
            },
            "thanos": {
              "type": "object",
              "properties": {
                "pullPolicy": {
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              }
            },
            "fluentbit": {
              "type": "object",
              "properties": {
                "pullPolicy": {
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              }
            }
          }
        },
        "foundationdb": {
          "type": "object",
          "properties": {
            "redundancyMode": {
              "enum": [
                "double",
                "triple"
              ]
            }
          }
        }
      }
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driverName": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "Never",
                "IfNotPresent"
              ]
            }
          }
        },
        "controllerReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "controllerNodeSelector": {
          "type": "object"
        },
        "controllerTolerations": {
          "type": "array"
        },
        "enableVolumeSnapshots": {
          "type": "boolean"
        },
        "enableServiceAccountAuth": {
          "type": "boolean"
        },
        "sidecarImages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provisioner": {
              "$ref": "#/definitions/imageReference"
            },
            "attacher": {
              "$ref": "#/definitions/imageReference"
            },
            "resizer": {
              "$ref": "#/definitions/imageReference"
            },
            "snapshotter": {
              "$ref": "#/definitions/imageReference"
            },
            "healthMonitor": {
              "$ref": "#/definitions/imageReference"
            },
            "nodeDriverRegistrar": {
              "$ref": "#/definitions/imageReference"
            },
            "csiAddons": {
              "$ref": "#/definitions/imageReference"
            }
          }
        },
        "pnfs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mds": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "nodeSelector": {
                  "type": "object"
                },
                "tolerations": {
                  "type": "array"
                },
                "resources": {
                  "type": "object"
                },
                "stateSize": {
                  "type": "string"
                },
                "dataNetwork": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "subnet": {
                      "type": "string"
                    },
                    "rangeStart": {
                      "type": "string"
                    },
                    "rangeEnd": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "namespace": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "operator": {
                "enum": [
                  "Exists",
                  "Equal"
                ]
              },
              "value": {
                "type": "string"
              },
              "effect": {
                "enum": [
                  "NoSchedule",
                  "PreferNoSchedule",
                  "NoExecute"
                ]
              },
              "tolerationSeconds": {
                "type": "integer"
              }
            }
          }
        },
        "enableControlPlaneNodes": {
          "type": "boolean"
        },
        "enableLogicalBlockDevices": {
          "type": "boolean"
        },
        "enablePartitionedDevices": {
          "type": "boolean"
        },
        "forceJournalDevice": {
          "type": "boolean"
        },
        "networkAttachment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "management": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
              "maxLength": 253
            },
            "data": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
              "maxLength": 253
            }
          }
        },
        "deviceFilter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "blockAllowList": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^/dev/[a-zA-Z0-9._/-]+$"
              }
            },
            "blockDenyList": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^/dev/[a-zA-Z0-9._/-]+$"
              }
            },
            "pcieAllowList": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{4}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}\\.[0-9a-fA-F]$"
              }
            },
            "pcieDenyList": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{4}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}\\.[0-9a-fA-F]$"
              }
            },
            "pcieModel": {
              "type": "string"
            },
            "driveSizeRange": {
              "type": "string",
              "pattern": "^$|^[0-9]+[KMGTP]?[i]?[B]?-[0-9]+[KMGTP]?[i]?[B]?$"
            }
          }
        },
        "draft": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "edgeCluster": {
              "type": "boolean"
            },
            "images": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "spdk": {
                  "type": "string"
                },
                "spdkProxy": {
                  "type": "string"
                }
              }
            },
            "cluster": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 37,
                  "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "stripe": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "dataChunks": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "parityChunks": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "maxSubsystemCount": {
                  "type": "integer",
                  "minimum": 10,
                  "maximum": 500
                },
                "enableDriveFormat": {
                  "type": "boolean"
                },
                "enableChecksumValidation": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "enableAtomicity4K": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "deployment": {
      "type": "object",
      "properties": {
        "profile": {
          "enum": [
            "standalone",
            "managed",
            "empty"
          ]
        }
      }
    },
    "controlCenter": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "full",
            "dr"
          ]
        },
        "authMode": {
          "enum": [
            "serviceaccount",
            "passthrough"
          ]
        },
        "image": {
          "type": "object",
          "properties": {
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "mock": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "properties": {
                "pullPolicy": {
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "csiSnapshotterController": {
          "type": "object",
          "properties": {
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "csiAddonsController": {
          "type": "object",
          "properties": {
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "simplyblock": {
          "type": "object",
          "properties": {
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "operator": {
          "type": "object",
          "properties": {
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "numaResource": {
          "type": "object",
          "properties": {
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        }
      }
    },
    "ramen": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        }
      }
    }
  },
  "definitions": {
    "imageReference": {
      "description": "A container image reference from any registry, mirrors included, carrying a tag, a digest, or both. Mirrors the crdtypes.ImageReference pattern in atlas-lib.",
      "type": "string",
      "pattern": "^($|(([a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)*|\\[[a-fA-F0-9:]+\\])(:[0-9]+)?/)?[a-z0-9]+((\\.|_|__|-+)[a-z0-9]+)*(/[a-z0-9]+((\\.|_|__|-+)[a-z0-9]+)*)*(:[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,127}(@sha256:[a-f0-9]{64})?|@sha256:[a-f0-9]{64}))$"
    }
  }
}
