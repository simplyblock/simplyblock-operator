.bin/
bundle/
cover.out
bin/
build/
__pycache__/

# Local, untracked make settings (SBCLI_DIR and the like).
local.mk

# An sbcli checkout for the OpenAPI export, where CI puts it.
/.sbcli/

# Packaged chart releases. The published Helm repository lives in the charts
# branch; only the chart sources are committed here.
/helm-charts/charts/*
!/helm-charts/charts/simplyblock-operator/
/csi-driver/charts/spdk-csi/*
!/csi-driver/charts/spdk-csi/latest/

# Support bundles hold a cluster's logs, node labels, and addresses, and are
# never a fixture: the fixtures are unpacked directories under
# support-tool/testdata.
simplyblock-bundle-*.tar.gz
