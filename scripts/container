#!/bin/bash

source ./scripts/setup-env

git config --global credential.helper store
git config --global url."https://github.com".insteadOf "git://github.com"
echo "https://${GITHUB_TOKEN}:x-oauth-basic@github.com" >> ~/.git-credentials

function expandBuildrootVariables() {
  make -f - expand -- "${@}" <<'EOF'
args := $(wordlist 2,$(words $(MAKECMDGOALS)),$(MAKECMDGOALS))
expanded := $(eval expanded := $(args))$(expanded)
.RECIPEPREFIX := >
.PHONY: expand
expand:
>@printf '%s' $(expanded)
%:
>@:
EOF
}

function getBusyboxConfigPath() {
  bbconf="$(cat "$1" | grep BR2_PACKAGE_BUSYBOX_CONFIG= | sed 's/BR2_PACKAGE_BUSYBOX_CONFIG="\(.*\)"/\1/')"
  echo "$(expandBuildrootVariables "${bbconf}")"
}

function setupBuildroot() {
  board=""
  fragments=()
  for arg in "$@"; do
    case "${arg}" in
      --prebuilt-sdk ) fragments+=("prebuilt-sdk") ;;
      --parallel ) fragments+=("parallel") ;;
      * ) board="${arg}" ;;
    esac
  done
  board=${board:-vela-qemu-x64}
  case "${board}" in
    vela-qemu-x64 )
      defconfig="vela_qemu_x64_defconfig"
    ;;

    * )
      defconfig="${board}_defconfig"
    ;;
  esac

  if [ ! -f ${PATH_PROTOTYPE}/configs/${defconfig} ] && [ ! -f ${PATH_BUILDROOT}/configs/${defconfig} ]; then
    echo "Unknown board configuration set '${defconfig}'"
    exit 1
  fi

  echo "Setting up buildroot to use configuration '${defconfig}'"
  make O=${BR2_OUTPUT_PATH} ${defconfig}

  # Switches are fragments merged over the board's defconfig, then resolved by
  # kconfig: --prebuilt-sdk replaces the toolchain the board would build with
  # the downloaded SDK, and --parallel turns on per-package directories.
  for fragment in "${fragments[@]}"; do
    echo "Merging ${fragment}.fragment"
    ${PATH_BUILDROOT}/support/kconfig/merge_config.sh -m -O ${BR2_OUTPUT_PATH} \
      ${BR2_OUTPUT_PATH}/.config ${PATH_PROTOTYPE}/configs/${fragment}.fragment || exit 1
  done
  if [ ${#fragments[@]} -gt 0 ]; then
    make O=${BR2_OUTPUT_PATH} olddefconfig || exit 1
    for fragment in "${fragments[@]}"; do
      # Every option a fragment sets has to survive kconfig, or the switch did
      # not take and the build would quietly be something else.
      grep -E '^BR2_[A-Za-z0-9_]+=' ${PATH_PROTOTYPE}/configs/${fragment}.fragment | while read -r line; do
        if ! grep -qxF "${line}" ${BR2_OUTPUT_PATH}/.config; then
          echo "${fragment}: ${line} did not take, the board's configuration rejected it"
          exit 1
        fi
      done || exit 1
    done
  fi

  if [ -f ${PATH_OUTPUT}/.config ]; then
    echo "Creating builder configuration..."
    echo "${PATH_DEVKIT}/builder.conf"
    [ -f "${PATH_DEVKIT}/builder.conf" ] && rm -rf "${PATH_DEVKIT}/builder.conf"
    echo "volDownloadCache=\"${volDownloadCache}\"" > "${PATH_DEVKIT}/builder.conf"
    echo "volCompilerCache=\"${volCompilerCache}\"" >> "${PATH_DEVKIT}/builder.conf"
    if [ -f ${PATH_PROTOTYPE}/configs/${defconfig} ]; then
      echo "buildrootDefconfig=\"${PATH_PROTOTYPE}/configs/${defconfig}\"" >> "${PATH_DEVKIT}/builder.conf"
    elif [ -f ${PATH_BUILDROOT}/configs/${defconfig} ]; then
      echo "buildrootDefconfig=\"${PATH_BUILDROOT}/configs/${defconfig}\"" >> "${PATH_DEVKIT}/builder.conf"
    fi
    busyboxConfig="$(getBusyboxConfigPath "${PATH_OUTPUT}/.config")"
    echo "busyboxDefconfig=\"${busyboxConfig}\"" >> "${PATH_DEVKIT}/builder.conf"
  fi
}

cd ${PATH_BUILDROOT}
MAKE="make O= O=${BR2_OUTPUT_PATH}"

echo "Loading buildroot..."

function getTargetTuple() {
  if [ -f "${BR2_OUTPUT_PATH}/.config" ] && grep -q '^BR2_aarch64=y$' "${BR2_OUTPUT_PATH}/.config"; then
    echo "aarch64-buildroot-linux-gnu"
  else
    echo "x86_64-buildroot-linux-gnu"
  fi
}

export TARGET_TUPLE="$(getTargetTuple)"
export SDK_NAME="${TARGET_TUPLE}_sdk-buildroot-host-${BUILDER_OS,,}-${BUILDER_ARCH}"

args=( "$@" )
case "${1}" in
  setup )
    setupBuildroot "${args[@]:1}"
  ;;

  config )
    export TERM=xterm
    tool=${2:-`echo buildroot`}
    case "${tool}" in
      linux )
        ${MAKE} linux-nconfig
      ;;

      busybox )
        ${MAKE} O=${BR2_OUTPUT_PATH} busybox-menuconfig
      ;;

      barebox )
        ${MAKE} O=${BR2_OUTPUT_PATH} barebox-menuconfig
      ;;

      * )
        ${MAKE} O=${BR2_OUTPUT_PATH} nconfig
      ;;
    esac
  ;;

  saveconfig )
    if [ ! -d ${BR2_OUTPUT_PATH}/build ]; then
      echo "Working directory not yet setup, please run 'builder setup'"
      exit -1
    fi

    echo "Saving buildroot configuration..."
    ${MAKE} savedefconfig

    if ls ${BR2_OUTPUT_PATH}/build/busybox-* 1> /dev/null 2>&1; then
      echo "Saving Busybox configuration..."
      bbconf="$(getBusyboxConfigPath "${buildrootDefconfig}")"
      cp "${bbconf}" "${bbconf}.old"
      ${MAKE} busybox-update-config
      [ "$(diff -u "${bbconf}" "${bbconf}.old" | grep -c "@@")" = "1" ] && \
          echo "Busybox config unchanged, reverting..." && \
          rm "${bbconf}" && \
          mv "${bbconf}.old" "${bbconf}"
      [ -f "${bbconf}.old" ] && rm "${bbconf}.old"
    fi

    if ls ${BR2_OUTPUT_PATH}/build/barebox-* 1> /dev/null 2>&1; then
      echo "Saving Barebox configuration..."
      ${MAKE} barebox-update-defconfig
    fi

    if ls ${BR2_OUTPUT_PATH}/build/linux-* 1> /dev/null 2>&1; then
      echo "Saving Linux configuration..."
      ${MAKE} linux-update-defconfig
    fi
  ;;

  clean )
    case "${2}" in
      target )
        echo "Cleaning target directory..."
        rm -rf ${BR2_OUTPUT_PATH}/target
        find ${BR2_OUTPUT_PATH}/ -name ".stamp_target_installed" | xargs rm -rf
      ;;

      ccache )
        echo "Cleaning CCACHE directory..."
        rm -rf ${HOME}/ccache/*
      ;;

      dlcache )
        echo "Cleaning download directory..."
        rm -rf ${HOME}/dlcache/*
      ;;

      * )
        if [ "${2}" != "" ]; then
          echo "Cleaning package ${2}..."
          if [ "$(${MAKE} ${2}-show-depends > /dev/null 2>&1 && echo $?)" == "0" ]; then
            ${MAKE} ${2}-dirclean
          fi
        else
          echo "Cleaning everything..."
          ${MAKE} clean
        fi
      ;;
    esac
  ;;

  build )
    cpus=$(grep -c processor /proc/cpuinfo)
    export BR2_JLEVEL=${BR2_JLEVEL:-$(expr ${cpus} + 1)}
    echo "Running multithreaded build with ${BR2_JLEVEL} make instances"
    if [ "${2}" == "dts" ]; then
       ${MAKE} linux-rebuild
    elif [ ! "${2}" == "" ]; then
      ${MAKE} ${2}-build
    elif grep -q '^BR2_PER_PACKAGE_DIRECTORIES=y$' ${BR2_OUTPUT_PATH}/.config; then
      # Packages build side by side, each with BR2_JLEVEL jobs of its own. The
      # load limit keeps the product of the two from swamping the host.
      echo "Building packages in parallel: -j${cpus} -l${cpus}"
      ${MAKE} -j${cpus} -l${cpus}
    else
      ${MAKE}
    fi
  ;;

  ccache )
    # buildroot's own ccache and cache directory: `ccache stats`, `ccache zero`.
    # Not buildroot's ccache-stats target: it runs output/host/bin/ccache,
    # which per-package directories only assemble at the end of a build, so
    # it fails before the first one. The binary is taken from wherever
    # host-ccache installed it.
    case "${2}" in
      stats ) option="--show-stats" ;;
      zero ) option="--zero-stats" ;;
      * ) echo "Usage: ccache stats|zero"; exit 1 ;;
    esac
    ${MAKE} host-ccache > /dev/null || exit 1
    for ccache in ${BR2_OUTPUT_PATH}/per-package/host-ccache/host/bin/ccache ${BR2_OUTPUT_PATH}/host/bin/ccache; do
      if [ -x "${ccache}" ]; then
        CCACHE_DIR="${BR2_CCACHE_DIR}" ${ccache} ${option}
        exit $?
      fi
    done
    echo "host-ccache built, but no ccache binary found"
    exit 1
  ;;

  rebuild )
    ${MAKE} ${2}-rebuild
  ;;

  download )
    ${MAKE} source
  ;;

  dependencies )
    BR2_GRAPH_OUT=svg ${MAKE} graph-depends
    cp ${BR2_OUTPUT_PATH}/graphs/*.svg ${BR2_OUTPUT_PATH}/images/
  ;;

  buildtimegraph )
    ${MAKE} graph-build
    cp ${BR2_OUTPUT_PATH}/graphs/build.* ${BR2_OUTPUT_PATH}/images/
  ;;

  buildsize )
    ${MAKE} graph-size
    cp ${BR2_OUTPUT_PATH}/graphs/graph-size.pdf ${BR2_OUTPUT_PATH}/images/
    cp ${BR2_OUTPUT_PATH}/graphs/package-size-stats.csv ${BR2_OUTPUT_PATH}/images/
    cp ${BR2_OUTPUT_PATH}/graphs/file-size-stats.csv ${BR2_OUTPUT_PATH}/images/
  ;;

  licenses )
    ${MAKE} legal-info
    mv ${BR2_OUTPUT_PATH}/legal-info ${BR2_OUTPUT_PATH}/images
  ;;

  makesdk )
    ${MAKE} sdk
    mv ${BR2_OUTPUT_PATH}/images/${TARGET_TUPLE}_sdk-buildroot.tar.gz ${BR2_OUTPUT_PATH}/images/${SDK_NAME}.tar.gz
  ;;

  env )
    ${MAKE} -s printvars
  ;;

  * )
    echo "Unknown command"
    exit 1
  ;;
esac